# Frontend environment. Copy to .env:
#   cp .env.example .env
#
# Vite only reads .env files from THIS directory, and only exposes variables
# prefixed with VITE_. Anything with that prefix is compiled into the bundle
# and visible to anyone who opens devtools — never put a secret behind one.

VITE_SUPABASE_URL=https://uatppdlslsrsfleoullv.supabase.co

# Publishable key. Safe in the browser by design: it grants no privileges of
# its own, and every request it makes runs under the signed-in user's JWT and
# is filtered by Row Level Security.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_GC2sZz6h0iRtC9AmD5dWcA_3ingtHks

# Local AI demo: FastAPI runs on the same computer at port 8000.
# Vite may use localhost:5173 or :5174; no backend CORS edit is needed.
VITE_API_URL=http://localhost:8000
# Netlify: override VITE_API_URL with the HTTPS Cloudflare Tunnel base URL
# (no /api suffix or trailing slash), then rebuild/redeploy. Never use localhost there.
# Leave blank to use deterministic routing without backend AI.
# Never point this at Ollama port 11434 or put a server secret in VITE_* variables.
